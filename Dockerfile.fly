# syntax=docker/dockerfile:1
FROM denoland/deno:2.9.7 AS dashboard-build
ENV DENO_DIR=/deno-dir
WORKDIR /app/placer-dashboard
COPY placer-dashboard/deno.json placer-dashboard/deno.lock placer-dashboard/package.json ./
RUN deno install --frozen --allow-scripts=npm:esbuild
COPY placer-dashboard/ ./
RUN deno task build && deno cache --frozen server.ts && deno eval --frozen 'await import("./server.ts")'

FROM python:3.11.14-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gosu && rm -rf /var/lib/apt/lists/*
ARG FLYCTL_VERSION=0.4.108
RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64) arch=x86_64 ;; arm64) arch=arm64 ;; *) exit 1 ;; esac; \
    archive="flyctl_${FLYCTL_VERSION}_Linux_${arch}.tar.gz"; \
    base="https://github.com/superfly/flyctl/releases/download/v${FLYCTL_VERSION}"; \
    curl -fsSL "$base/$archive" -o "/tmp/$archive"; \
    curl -fsSL "$base/flyctl_${FLYCTL_VERSION}_checksums.txt" -o /tmp/fly-checksums; \
    cd /tmp; grep " $archive$" fly-checksums | sha256sum -c -; \
    tar -xzf "$archive" -C /usr/local/bin flyctl; \
    ln -s /usr/local/bin/flyctl /usr/local/bin/fly; \
    rm -f "$archive" fly-checksums

WORKDIR /app/placer-service
COPY placer-service/requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt
COPY placer-service/ ./
COPY --from=dashboard-build /usr/bin/deno /usr/local/bin/deno
COPY --from=dashboard-build --chown=10001:10001 /deno-dir /deno-dir
COPY --from=dashboard-build --chown=10001:10001 /app/placer-dashboard /app/placer-dashboard
ENV DENO_DIR=/deno-dir PLACER_SERVICE_URL=http://placer.process.fly-auto-placer.internal:8000
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app && \
    mkdir -p /app/placer-service/data && chown app:app /app/placer-service/data
COPY entrypoint.fly.sh /entrypoint.fly.sh
RUN chmod 755 /entrypoint.fly.sh
EXPOSE 8000 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://localhost:8000/health || curl -fsS http://localhost:8080/health || exit 1
ENTRYPOINT ["/entrypoint.fly.sh"]
CMD ["placer"]
