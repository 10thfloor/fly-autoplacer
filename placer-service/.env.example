# Required even in dry-run mode. Generate a random token; use the same value in the dashboard.
PLACER_API_TOKEN=

# Required only when config/config.yml sets dry_run: false.
# This explicitly names the CUSTOMER application to place, not the controller.
PLACER_TARGET_APP=
FLY_API_TOKEN=
FLY_PROMETHEUS_URL=https://api.fly.io/prometheus/YOUR_ORG

# Optional paths/listen overrides:
# PLACER_CONFIG_FILE=config/config.yml
# HOST=127.0.0.1
# PORT=8000
